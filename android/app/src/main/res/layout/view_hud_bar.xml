<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    tools:parentTag="android.widget.FrameLayout">

    <View
        android:id="@+id/hud_shadow"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginStart="6dp"
        android:layout_marginTop="6dp"
        android:background="@drawable/brutal_shadow_dark"
        android:importantForAccessibility="no" />

    <LinearLayout
        android:id="@+id/hud_body"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginEnd="6dp"
        android:layout_marginBottom="6dp"
        android:background="@drawable/hud_block"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingEnd="12dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/hud_button_left"
            style="@style/Widget.App.Button.Lane"
            android:layout_width="@dimen/hud_button_width"
            android:layout_height="@dimen/hud_button_height"
            android:contentDescription="@string/game_lane_left_desc"
            android:text="@string/game_lane_left"
            app:icon="@drawable/ic_chevron_left"
            app:iconGravity="textStart"
            app:iconSize="@dimen/icon_size" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <LinearLayout
                android:id="@+id/hud_life_row"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <View
                    android:id="@+id/hud_life_0"
                    android:layout_width="@dimen/life_pip_size"
                    android:layout_height="@dimen/life_pip_size"
                    android:layout_marginEnd="6dp"
                    android:background="@drawable/life_pip_on"
                    android:importantForAccessibility="no" />

                <View
                    android:id="@+id/hud_life_1"
                    android:layout_width="@dimen/life_pip_size"
                    android:layout_height="@dimen/life_pip_size"
                    android:layout_marginEnd="6dp"
                    android:background="@drawable/life_pip_on"
                    android:importantForAccessibility="no" />

                <View
                    android:id="@+id/hud_life_2"
                    android:layout_width="@dimen/life_pip_size"
                    android:layout_height="@dimen/life_pip_size"
                    android:background="@drawable/life_pip_on"
                    android:importantForAccessibility="no" />

            </LinearLayout>

            <TextView
                android:id="@+id/hud_miss"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:accessibilityLiveRegion="polite"
                android:drawablePadding="4dp"
                android:maxLines="1"
                android:textAppearance="@style/TextAppearance.App.Label"
                android:textColor="@color/text_secondary"
                app:drawableStartCompat="@drawable/ic_crate"
                app:drawableTint="@color/text_muted" />

        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/hud_button_right"
            style="@style/Widget.App.Button.Lane"
            android:layout_width="@dimen/hud_button_width"
            android:layout_height="@dimen/hud_button_height"
            android:contentDescription="@string/game_lane_right_desc"
            android:text="@string/game_lane_right"
            app:icon="@drawable/ic_chevron_right"
            app:iconGravity="textStart"
            app:iconSize="@dimen/icon_size" />

    </LinearLayout>

</merge>
