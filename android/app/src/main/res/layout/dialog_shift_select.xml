<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="10dp">

    <LinearLayout
        android:id="@+id/shift_dialog_body"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/dialog_block_amber"
        android:orientation="vertical"
        android:paddingStart="@dimen/dialog_padding"
        android:paddingTop="@dimen/dialog_padding"
        android:paddingEnd="27dp"
        android:paddingBottom="27dp">

        <TextView
            android:id="@+id/shift_dialog_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/dialog_shift_title"
            android:textAppearance="@style/TextAppearance.App.Headline"
            android:textSize="22sp" />

        <View
            android:layout_width="76dp"
            android:layout_height="@dimen/dialog_title_rule_height"
            android:layout_marginTop="10dp"
            android:background="@drawable/rule_amber"
            android:importantForAccessibility="no" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/shift_dialog_list"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dialog_list_height"
            android:layout_marginTop="16dp"
            android:clipToPadding="false"
            android:overScrollMode="never" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/shift_dialog_close"
                style="@style/Widget.App.Button.Secondary"
                android:layout_width="0dp"
                android:layout_height="@dimen/touch_min"
                android:layout_weight="1"
                android:text="@string/dialog_shift_close"
                app:strokeColor="@color/outline" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/shift_dialog_confirm"
                style="@style/Widget.App.Button.Primary"
                android:layout_width="0dp"
                android:layout_height="@dimen/touch_min"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:text="@string/dialog_shift_confirm"
                android:textSize="15sp" />

        </LinearLayout>

    </LinearLayout>

</RelativeLayout>
