<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_base">

    <ImageView
        android:id="@+id/result_background"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="centerCrop"
        android:src="@drawable/bg_menu" />

    <View
        android:id="@+id/result_scrim"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/gradient_result_scrim_lose"
        android:importantForAccessibility="no" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingStart="@dimen/screen_margin"
            android:paddingTop="@dimen/header_status_padding"
            android:paddingEnd="@dimen/screen_margin"
            android:paddingBottom="48dp">

            <FrameLayout
                android:id="@+id/result_new_best"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/new_best_block"
                    android:letterSpacing="0.22"
                    android:paddingStart="16dp"
                    android:paddingTop="6dp"
                    android:paddingEnd="16dp"
                    android:paddingBottom="6dp"
                    android:text="@string/result_new_best"
                    android:textAllCaps="true"
                    android:textColor="@color/on_accent"
                    android:textSize="13sp"
                    android:textStyle="bold" />

            </FrameLayout>

            <FrameLayout
                android:id="@+id/result_verdict"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp">

                <View
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_marginStart="@dimen/hard_shadow_offset_large"
                    android:layout_marginTop="@dimen/hard_shadow_offset_large"
                    android:background="@drawable/brutal_shadow_coral"
                    android:importantForAccessibility="no" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="@dimen/hard_shadow_offset_large"
                    android:layout_marginBottom="@dimen/hard_shadow_offset_large"
                    android:background="@drawable/verdict_block"
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:paddingStart="18dp"
                    android:paddingTop="24dp"
                    android:paddingEnd="18dp"
                    android:paddingBottom="24dp">

                    <TextView
                        android:id="@+id/result_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:textAppearance="@style/TextAppearance.App.Display"
                        android:textSize="34sp" />

                    <View
                        android:layout_width="96dp"
                        android:layout_height="5dp"
                        android:layout_marginTop="14dp"
                        android:background="@drawable/rule_amber"
                        android:importantForAccessibility="no" />

                    <TextView
                        android:id="@+id/result_reason"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:accessibilityLiveRegion="polite"
                        android:gravity="center"
                        android:textAppearance="@style/TextAppearance.App.Label"
                        android:textColor="@color/text_secondary"
                        android:textSize="13sp" />

                </LinearLayout>

            </FrameLayout>

            <LinearLayout
                android:id="@+id/result_stats_row"
                android:layout_width="match_parent"
                android:layout_height="@dimen/stat_card_height"
                android:layout_marginTop="22dp"
                android:orientation="horizontal"
                android:visibility="gone">

                <com.NqXkLmR.vJpTzF.core.ui.StatCardView
                    android:id="@+id/result_stat_chain"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    app:statAccentColor="@color/accent_lime"
                    app:statLabel="@string/stat_chain" />

                <com.NqXkLmR.vJpTzF.core.ui.StatCardView
                    android:id="@+id/result_stat_accuracy"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    app:statAccentColor="@color/accent_amber"
                    app:statLabel="@string/stat_accuracy" />

                <com.NqXkLmR.vJpTzF.core.ui.StatCardView
                    android:id="@+id/result_stat_best"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    app:statAccentColor="@color/accent_coral"
                    app:statLabel="@string/stat_best" />

            </LinearLayout>

            <TextView
                android:id="@+id/result_points"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:drawablePadding="8dp"
                android:letterSpacing="0.2"
                android:textAllCaps="true"
                android:textColor="@color/accent_cyan"
                android:textSize="13sp"
                android:textStyle="bold"
                app:drawableStartCompat="@drawable/ic_trophy"
                app:drawableTint="@color/accent_cyan" />

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="@dimen/result_button_primary_height"
                android:layout_marginTop="26dp">

                <View
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_marginStart="@dimen/hard_shadow_offset"
                    android:layout_marginTop="@dimen/hard_shadow_offset"
                    android:background="@drawable/brutal_shadow_coral"
                    android:importantForAccessibility="no" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/result_play_again"
                    style="@style/Widget.App.Button.Primary"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_marginEnd="@dimen/hard_shadow_offset"
                    android:layout_marginBottom="@dimen/hard_shadow_offset"
                    android:text="@string/result_play_again"
                    android:textSize="20sp" />

            </FrameLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/result_menu"
                style="@style/Widget.App.Button.Secondary"
                android:layout_width="match_parent"
                android:layout_height="@dimen/result_button_secondary_height"
                android:layout_marginTop="14dp"
                android:text="@string/result_menu"
                app:strokeColor="@color/text_primary" />

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

</FrameLayout>
