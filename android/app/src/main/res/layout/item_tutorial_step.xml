<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/tutorial_item_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    android:background="@drawable/item_block_default"
    android:gravity="center_vertical"
    android:minHeight="@dimen/touch_min"
    android:orientation="horizontal"
    android:paddingStart="12dp"
    android:paddingTop="12dp"
    android:paddingEnd="17dp"
    android:paddingBottom="17dp">

    <TextView
        android:id="@+id/tutorial_item_number"
        android:layout_width="@dimen/marker_square_size"
        android:layout_height="@dimen/marker_square_size"
        android:background="@drawable/marker_square"
        android:gravity="center"
        android:textColor="@color/accent_amber"
        android:textSize="14sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tutorial_item_text"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:textAppearance="@style/TextAppearance.App.Body"
        android:textColor="@color/text_primary"
        android:textSize="12sp" />

    <ImageView
        android:id="@+id/tutorial_item_sprite"
        android:layout_width="@dimen/tutorial_sprite_size"
        android:layout_height="@dimen/tutorial_sprite_size"
        android:layout_marginStart="10dp"
        android:contentDescription="@string/tutorial_sprite_desc"
        android:scaleType="fitCenter" />

</LinearLayout>
