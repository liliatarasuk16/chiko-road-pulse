<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_deep">

    <ImageView
        android:id="@+id/splash_background"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="centerCrop"
        android:src="@drawable/bg_splash" />

    <View
        android:id="@+id/splash_stripe_one"
        android:layout_width="28dp"
        android:layout_height="@dimen/splash_stripe_height"
        android:layout_gravity="start|top"
        android:layout_marginStart="36dp"
        android:layout_marginTop="90dp"
        android:alpha="0.18"
        android:background="@drawable/stripe_lane"
        android:importantForAccessibility="no"
        android:rotation="22" />

    <View
        android:id="@+id/splash_stripe_two"
        android:layout_width="28dp"
        android:layout_height="@dimen/splash_stripe_height"
        android:layout_gravity="center_horizontal|top"
        android:layout_marginTop="40dp"
        android:alpha="0.18"
        android:background="@drawable/stripe_lane"
        android:importantForAccessibility="no"
        android:rotation="22" />

    <View
        android:id="@+id/splash_stripe_three"
        android:layout_width="28dp"
        android:layout_height="@dimen/splash_stripe_height"
        android:layout_gravity="end|top"
        android:layout_marginTop="120dp"
        android:layout_marginEnd="30dp"
        android:alpha="0.18"
        android:background="@drawable/stripe_lane"
        android:importantForAccessibility="no"
        android:rotation="22" />

    <View
        android:id="@+id/splash_scrim"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/gradient_splash_scrim"
        android:importantForAccessibility="no" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingStart="@dimen/screen_margin"
        android:paddingTop="@dimen/header_status_padding"
        android:paddingEnd="@dimen/screen_margin"
        android:paddingBottom="40dp">

        <FrameLayout
            android:id="@+id/splash_badge_frame"
            android:layout_width="154dp"
            android:layout_height="154dp">

            <View
                android:layout_width="@dimen/splash_badge_size"
                android:layout_height="@dimen/splash_badge_size"
                android:layout_gravity="bottom|end"
                android:background="@drawable/brutal_shadow_coral"
                android:importantForAccessibility="no" />

            <FrameLayout
                android:layout_width="@dimen/splash_badge_size"
                android:layout_height="@dimen/splash_badge_size"
                android:layout_gravity="top|start"
                android:background="@drawable/brutal_badge_amber">

                <ImageView
                    android:id="@+id/splash_badge_sprite"
                    android:layout_width="@dimen/splash_badge_sprite"
                    android:layout_height="@dimen/splash_badge_sprite"
                    android:layout_gravity="center"
                    android:contentDescription="@string/splash_badge_desc"
                    android:scaleType="fitCenter"
                    android:src="@drawable/sprite_cart" />

            </FrameLayout>

        </FrameLayout>

        <TextView
            android:id="@+id/splash_title_top"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="34dp"
            android:text="@string/splash_title_top"
            android:textAppearance="@style/TextAppearance.App.Display" />

        <TextView
            android:id="@+id/splash_title_bottom"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/splash_title_bottom"
            android:textAppearance="@style/TextAppearance.App.Display"
            android:textColor="@color/accent_amber" />

        <View
            android:id="@+id/splash_rule"
            android:layout_width="@dimen/splash_rule_width"
            android:layout_height="@dimen/splash_rule_height"
            android:layout_marginTop="16dp"
            android:background="@drawable/rule_amber"
            android:importantForAccessibility="no" />

        <TextView
            android:id="@+id/splash_subtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:letterSpacing="0.22"
            android:text="@string/splash_subtitle"
            android:textAllCaps="true"
            android:textColor="@color/accent_cyan"
            android:textSize="13sp"
            android:textStyle="bold" />

        <com.google.android.material.progressindicator.LinearProgressIndicator
            android:id="@+id/splash_progress"
            android:layout_width="@dimen/splash_progress_width"
            android:layout_height="wrap_content"
            android:layout_marginTop="40dp"
            android:indeterminate="true"
            app:indicatorColor="@color/accent_amber"
            app:trackColor="@color/surface_raised"
            app:trackCornerRadius="0dp"
            app:trackThickness="8dp" />

        <TextView
            android:id="@+id/splash_loading"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:accessibilityLiveRegion="polite"
            android:text="@string/splash_loading"
            android:textAppearance="@style/TextAppearance.App.Label" />

    </LinearLayout>

</FrameLayout>
