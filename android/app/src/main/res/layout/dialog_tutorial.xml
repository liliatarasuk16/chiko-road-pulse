<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="10dp">

    <LinearLayout
        android:id="@+id/tutorial_dialog_body"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/dialog_block_cyan"
        android:orientation="vertical"
        android:paddingStart="@dimen/dialog_padding"
        android:paddingTop="@dimen/dialog_padding"
        android:paddingEnd="27dp"
        android:paddingBottom="27dp">

        <TextView
            android:id="@+id/tutorial_dialog_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/dialog_tutorial_title"
            android:textAppearance="@style/TextAppearance.App.Headline"
            android:textSize="22sp" />

        <View
            android:layout_width="76dp"
            android:layout_height="@dimen/dialog_title_rule_height"
            android:layout_marginTop="10dp"
            android:background="@drawable/rule_amber"
            android:importantForAccessibility="no" />

        <com.NqXkLmR.vJpTzF.core.ui.SequenceStripView
            android:id="@+id/tutorial_dialog_strip"
            android:layout_width="match_parent"
            android:layout_height="@dimen/sequence_strip_height"
            android:layout_marginTop="12dp" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/tutorial_dialog_list"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dialog_tutorial_list_height"
            android:layout_marginTop="8dp"
            android:clipToPadding="false"
            android:overScrollMode="never" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/tutorial_dialog_confirm"
            style="@style/Widget.App.Button.Primary"
            android:layout_width="match_parent"
            android:layout_height="@dimen/touch_min"
            android:layout_marginTop="18dp"
            android:text="@string/dialog_tutorial_confirm"
            android:textSize="16sp" />

    </LinearLayout>

</RelativeLayout>
