<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="10dp">

    <LinearLayout
        android:id="@+id/pause_dialog_body"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/dialog_block_amber"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="@dimen/dialog_padding"
        android:paddingTop="@dimen/dialog_padding"
        android:paddingEnd="27dp"
        android:paddingBottom="27dp">

        <TextView
            android:id="@+id/pause_dialog_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/dialog_pause_title"
            android:textAppearance="@style/TextAppearance.App.Display"
            android:textSize="30sp" />

        <View
            android:layout_width="76dp"
            android:layout_height="@dimen/dialog_title_rule_height"
            android:layout_marginTop="10dp"
            android:background="@drawable/rule_amber"
            android:importantForAccessibility="no" />

        <TextView
            android:id="@+id/pause_dialog_note"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:gravity="center"
            android:text="@string/dialog_pause_note"
            android:textAppearance="@style/TextAppearance.App.Label"
            android:textColor="@color/text_secondary" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/pause_dialog_resume"
            style="@style/Widget.App.Button.Primary"
            android:layout_width="match_parent"
            android:layout_height="@dimen/touch_min"
            android:layout_marginTop="22dp"
            android:text="@string/dialog_pause_resume"
            android:textSize="16sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/pause_dialog_menu"
            style="@style/Widget.App.Button.Secondary"
            android:layout_width="match_parent"
            android:layout_height="@dimen/touch_min"
            android:layout_marginTop="12dp"
            android:text="@string/dialog_pause_menu"
            app:icon="@drawable/ic_arrow_back"
            app:iconGravity="textStart"
            app:iconSize="@dimen/icon_size"
            app:iconTint="@color/text_primary"
            app:strokeColor="@color/text_primary" />

    </LinearLayout>

</RelativeLayout>
