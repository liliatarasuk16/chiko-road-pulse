<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.ChikoRoadPulse" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/accent_amber</item>
        <item name="colorOnPrimary">@color/on_accent</item>
        <item name="colorPrimaryContainer">@color/surface_raised</item>
        <item name="colorOnPrimaryContainer">@color/text_primary</item>
        <item name="colorSecondary">@color/accent_cyan</item>
        <item name="colorOnSecondary">@color/on_accent</item>
        <item name="colorTertiary">@color/accent_lime</item>
        <item name="colorOnTertiary">@color/on_accent</item>
        <item name="colorError">@color/accent_coral</item>
        <item name="colorOnError">@color/on_accent</item>
        <item name="colorSurface">@color/surface</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="colorSurfaceVariant">@color/surface_raised</item>
        <item name="colorOnSurfaceVariant">@color/text_secondary</item>
        <item name="colorOutline">@color/outline</item>
        <item name="colorControlHighlight">@color/ripple_light</item>
        <item name="android:colorBackground">@color/bg_base</item>
        <item name="android:windowBackground">@drawable/window_launch</item>
        <item name="android:statusBarColor">@color/bg_base</item>
        <item name="android:navigationBarColor">@color/bg_base</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
    </style>

    <style name="Theme.ChikoRoadPulse.Dialog" parent="Theme.Material3.DayNight.Dialog">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowMinWidthMajor">92%</item>
        <item name="android:windowMinWidthMinor">92%</item>
        <item name="colorPrimary">@color/accent_amber</item>
        <item name="colorOnPrimary">@color/on_accent</item>
        <item name="colorSurface">@color/surface</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="colorControlHighlight">@color/ripple_light</item>
    </style>
</resources>
